{
  "name": "sentence-lens",
  "version": "1.0.0",
  "description": "SentenceLens - Desktop Application (Pure Node.js)",
  "author": "ay-a",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "init-deps": "node init-server.js",
    "build-frontend": "cd frontend && npm run build",
    "build": "npm run build-frontend && electron-builder",
    "build-win": "npm run build-frontend && electron-builder --win",
    "build-mac": "npm run build-frontend && electron-builder --mac",
    "build-linux": "npm run build-frontend && electron-builder --linux"
  },
  "build": {
    "appId": "com.ay-a.SentenceLens",
    "productName": "SentenceLens",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "asar": true,
    "asarUnpack": [
      "server/**/*",
      "node_modules/**/*",
      "eng.traineddata",
      "data/dictionary/**/*"
    ],
    "files": [
      "main.js",
      "preload.js",
      "server/**/*",
      "renderer/**/*",
      "resources/**/*",
      "data/**/*",
      "node_modules/**/*",
      "eng.traineddata"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.education"
    },
    "linux": {
      "target": "AppImage",
      "category": "Education"
    }
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.80.0",
    "sql.js": "^1.12.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^26.8.1"
  }
}
